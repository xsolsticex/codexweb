# Configuración de correo Gmail. Copia este archivo a .env y completa tus datos.
# No añadas contraseñas a .env.example; .env queda excluido de Git.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
# Contraseña de aplicación de Google (no la contraseña habitual).
SMTP_PASSWORD=
# Ejemplo: MAIL_FROM="The Beer Codex <tu-cuenta@gmail.com>"
MAIL_FROM=
# Correo donde recibir las respuestas de los clientes.
MAIL_REPLY_TO=
